Symbol t
Symbol s
Symbol r
Symbol j
Symbol h
Class consonant {t, s, r, j, h}
Class syllabic {n̩, s̩, ɹ̩, i, a}

Syllables:
  explicit

syllabic-ification:
  @consonant$1 @consonant&$1 => $1 @syllabic / _ @consonant . // _ . @consonant
  Then: @consonant => {n̩, s̩, ɹ̩, i, a} / _ . // @syllabic _

aspiration:
  h => s / t _ @syllabic // t . _ @syllabic
  {sh, rh, jh} => {x, ʂ, ʃ} / _ @syllabic // _ . @consonant

